using Gtk 4.0;
using Adw 1;
using GtkSource 5;

Adw.ApplicationWindow window {
  title: "Oh My SVG";

  Stack stack {
    StackPage {
      name: "view_open";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;

          [end]
          MenuButton {
            menu-model: menu_app;
            icon-name: "open-menu-symbolic";
            primary: true;
          }
        }

        content: Adw.StatusPage {
          vexpand: true;
          icon-name: "re.sonny.OhMySVG";
          title: _("Oh My SVG");
          description: _("Click “Open File…” or drop SVG file here");

          styles [
            "icon-dropshadow",
          ]

          Box {
            orientation: vertical;
            halign: center;
            spacing: 10;

            Button {
              halign: center;
              label: _("Open File…");
              action-name: "win.open";
              use-underline: true;

              styles [
                "suggested-action",
                "pill",
              ]
            }

            Button button_demo {
              halign: center;
              label: _("Open Demo");

              styles [
                "pill",
              ]
            }
          }
        };
      };
    }

    StackPage {
      name: "view_edit";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [start]
          ToggleButton sidebar_toggle {
            active: bind split_view.show-sidebar;
            icon-name: "sidebar-show-symbolic";
          }

          title-widget: Adw.ViewSwitcher {
            stack: inner_stack;
          };

          [end]
          MenuButton button_menu {
            menu-model: menu_app;
            icon-name: "open-menu-symbolic";
            primary: true;
          }
        }

        [bottom]
        ActionBar {
          hexpand: true;

          [start]
          Button button_copy {
            action-name: "win.copy";
            accessibility {
              label: _("Copy Markup");
            }
            Adw.ButtonContent button_copy_contents {
              icon-name: "edit-copy-symbolic";
              label: _("Copy Markup");
            }
          }

          [center]
          Label label_size {
            justify: center;
          }

          [end]
          Button button_save {
            styles [
              "suggested-action",
            ]
            action-name: "win.save";
            accessibility {
              label: _("Save As…");
            }
            Adw.ButtonContent button_save_contents {
              icon-name: "document-save-as-symbolic";
              label: _("Save As…");
            }
          }
        }

        content: Adw.OverlaySplitView split_view {
          show-sidebar: bind sidebar_toggle.active;
          collapsed: true;

          sidebar: Box sidebar {
            width-request: 300;
            orientation: vertical;

            Box {
              orientation: vertical;
              margin-start: 8;
              margin-end: 8;
              margin-top: 8;

              Label {
                margin-top: 20;
                margin-bottom: 10;
                label: _("Precision");
                xalign: 0;

                styles [
                  "heading",
                ]
              }

              Scale scale {
                adjustment: adjustment;
                round-digits: 0;
                digits: 0;

                marks [
                  mark (0, bottom),
                  mark (1, bottom),
                  mark (2, bottom),
                  mark (3, bottom),
                  mark (4, bottom),
                  mark (5, bottom),
                  mark (6, bottom),
                  mark (7, bottom),
                  mark (8, bottom),
                  mark (9, bottom),
                ]
              }

              Label {
                margin-top: 20;
                margin-bottom: 10;
                label: _("Features");
                xalign: 0;

                styles [
                  "heading",
                ]
              }
            }

            ScrolledWindow {
              hscrollbar-policy: never;
              min-content-height: 200;
              hexpand: false;
              vexpand: true;

              Viewport {
                scroll-to-focus: true;

                Adw.Bin {
                  margin-start: 8;
                  margin-end: 8;
                  margin-bottom: 8;

                  Frame {
                    ListBox plugins_box {
                      selection-mode: none;

                      styles [
                        "boxed-list",
                      ]
                    }
                  }
                }
              }
            }
          };

          content: Adw.ViewStack inner_stack {

            Adw.ViewStackPage {
              name: "inner_image";
              title: _("Image");
              icon-name: "image-x-generic-symbolic";

              child: ScrolledWindow {
                hexpand: true;
                vexpand: true;

                Viewport {
                  DrawingArea drawing_area {}
                }
              };
            }

            Adw.ViewStackPage {
              name: "inner_markup";
              title: _("Markup");
              icon-name: "text-editor-symbolic";

              child: ScrolledWindow {
                hexpand: true;
                vexpand: true;

                GtkSource.View {
                  show-line-numbers: true;
                  monospace: true;
                  editable: false;
                  wrap-mode: char;

                  buffer: GtkSource.Buffer source_buffer {};
                }
              };
            }
          };
        };
      };
    }
  }

  Adw.Breakpoint mid_break {
    condition ("max-width: 700sp")

    setters {
      button_save_contents.label: null;
      button_copy_contents.label: null;
    }
  }

  Adw.Breakpoint wide_break {
    condition ("min-width: 800sp")

    setters {
      split_view.collapsed: false;
      sidebar_toggle.visible: false;
    }
  }

}

menu menu_app {
  section {
    item {
      label: _("_Open File…");
      action: "win.open";
    }

    item {
      label: _("_Save As…");
      action: "win.save";
      sensitive: "false";
      disabled: "true";
    }

    item {
      label: _("_Reload");
      action: "win.reload";
      sensitive: "false";
      disabled: "true";
    }

    item {
      label: _("_Paste Markup");
      action: "win.paste";
      sensitive: "false";
      disabled: "true";
    }
  }

  section {}

  section {
    item {
      label: _("_New Window");
      action: "app.new";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Oh My SVG");
      action: "app.about";
    }
  }
}

Adjustment adjustment {
  lower: 0;
  upper: 9;
  value: 3;
  step-increment: 1;
  page-increment: 1;
}
